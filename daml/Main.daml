-- | The demo application.
--
-- Neither `greeting` nor `Amulet` is defined anywhere in this repository. Both
-- come from DARs that live in other git repositories, declared as git lines in
-- daml.yaml. Those two lines are the whole point
-- of this demo: no vendored .dar file, no registry, no manual download step.
module Main where

import Daml.Script

import Hello (greeting)
import Splice.Amulet (Amulet)

template Greeting
  with
    owner : Party
    message : Text
  where
    signatory owner

    ensure message /= ""

    choice Reword : ContractId Greeting
      with
        newMessage : Text
      controller owner
      do
        create this with message = newMessage

-- | Built from text that came out of the git-hosted Hello DAR.
baselineMessage : Text
baselineMessage = greeting <> " from dpm-git-links-demo"

-- | Reads a field off a template type defined in the git-hosted splice-amulet
-- DAR. Nothing in this demo creates an Amulet; naming the type is enough to
-- make the second link load-bearing.
amuletOwner : Amulet -> Party
amuletOwner amulet = amulet.owner

setup : Script (Party, ContractId Greeting)
setup = do
  alice <- allocateParty "Alice"
  cid <- submit alice do
    createCmd Greeting with owner = alice, message = baselineMessage
  pure (alice, cid)
