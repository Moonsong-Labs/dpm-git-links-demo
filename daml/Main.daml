-- | The demo application.
--
-- `greeting` is not defined anywhere in this repository. It comes from a DAR
-- that lives in another git repository, declared as a single line under
-- `data-dependencies` in daml.yaml. That one line is the whole point of this
-- demo: no vendored .dar file, no registry, no manual download step.
module Main where

import Daml.Script

import Hello (greeting)

template Greeting
  with
    owner : Party
    message : Text
  where
    signatory owner

    ensure message /= ""

    choice Reword : ContractId Greeting
      with
        newMessage : Text
      controller owner
      do
        create this with message = newMessage

-- | Built from text that came out of the git-hosted DAR.
baselineMessage : Text
baselineMessage = greeting <> " from dpm-git-links-demo"

setup : Script (Party, ContractId Greeting)
setup = do
  alice <- allocateParty "Alice"
  cid <- submit alice do
    createCmd Greeting with owner = alice, message = baselineMessage
  pure (alice, cid)
